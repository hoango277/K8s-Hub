# backend/.env for running K8s-Hub INSIDE the lab1 cluster (the dev workspace pod).
# Copy to backend/.env in the workspace and fill in the secrets.
# Everything is reached by cluster DNS name, not by lab1 NodePorts.

APP_NAME="K8s Hub"
APP_ENV=dev
DEBUG=true
LOG_FORMAT=text
# The browser reaches the frontend via NodePort 30830.
CORS_ORIGINS=["http://lab1:30830","http://localhost:3000"]

# CloudNativePG read-write service. Same database/user as the laptop setup.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@pg-rw.database.svc:5432/<db>

JWT_SECRET=<same value as before, or stored API keys can't be decrypted>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

GROQ_API_KEY=
GOOGLE_API_KEY=

# Kubernetes: the pod's ServiceAccount (view cluster-wide), no kubeconfig file.
K8S_IN_CLUSTER=true
KUBECONFIG=
K8S_EXECUTION_MODE=require_approval
K8S_ALLOWED_NAMESPACES=[]

# Observability sources of the cluster, by service DNS name.
PROMETHEUS_URL=http://kps-kube-prometheus-stack-prometheus.monitoring.svc:9090
LOKI_URL=http://loki-gateway.loki.svc
TEMPO_URL=http://tempo.tempo.svc:3200

LANGFUSE_ENABLED=true
LANGFUSE_BASE_URL=http://langfuse-web.langfuse.svc:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
