# This file is the STATIC configuration — read once at startup.
# Entries marked [editable on web] only hold the initial default here;
# changes made by users in the UI override them and are persisted.
# See RUNTIME_EDITABLE in app/core/config.py for which fields are editable.
#
# INFRASTRUCTURE DOES NOT RUN ON LOCALHOST. PostgreSQL, Redis, Langfuse, Prometheus
# and Loki live on the Kubernetes cluster lab1. The localhost values below are
# just placeholders — replace them with the cluster's real addresses before
# running. The repo has no docker-compose.yml, don't look for one.

# ---------- App ----------
APP_NAME="K8s Hub"
APP_ENV=local
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/k8shub

# ---------- Redis ----------
# NOT USED anywhere in the code yet, and the lab1 cluster has no dedicated Redis
# either (the one running belongs to Argo CD and isn't shared). Leave as is
# until background jobs are built.
REDIS_URL=redis://localhost:6379/0

# ---------- Auth ----------
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# The first admin account. There is NO public sign-up for the admin/engineer
# roles — at startup, if the database has no admin yet, the system creates (or
# upgrades) the account with this email. Leave empty to skip that step — and
# create an admin some other way. See app/services/user_service.py::bootstrap_admin.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ---------- LLM ----------  [editable on web]
# Only model call parameters remain. Do NOT choose a provider or model here:
# users pick one per chat turn in the model picker, and the model list comes
# straight from the provider's API. If nothing is picked, the FIRST provider
# with an API key filled in (order groq -> google) is used with its default
# model. The system only supports Groq and Google.
# The LLM_PROVIDER, LLM_MODEL, LLM_FAST_MODEL, LLM_PROVIDERS variables were
# removed — leftovers in an old .env are ignored and cause no errors.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# API keys — each provider you fill in shows up in the model picker.
GROQ_API_KEY=
GOOGLE_API_KEY=

# ---------- Kubernetes ----------  [K8S_EXECUTION_MODE and ALLOWED_NAMESPACES editable on web]
KUBECONFIG=
K8S_IN_CLUSTER=false
# read_only | require_approval | auto
K8S_EXECUTION_MODE=require_approval
K8S_ALLOWED_NAMESPACES=[]

# ---------- Observability data sources ----------  [editable on web]
# Real address on the lab1 cluster (kube-prometheus-stack, NodePort 30090).
PROMETHEUS_URL=http://lab1:30090

# NOTE: Loki on lab1 currently ONLY has ClusterIP Services (loki:3100 and
# loki-gateway:80), not exposed outside the cluster. It can't be reached from
# the development machine yet. To use it, add a NodePort/Ingress for
# loki-gateway, or temporarily:
#     kubectl -n loki port-forward svc/loki-gateway 3100:80
LOKI_URL=http://localhost:3100
# Grafana Tempo query API (port 3200). Leave empty until Tempo is deployed and
# apps send traces (Beyla/OpenTelemetry via Alloy). lab1: http://lab1:30200
TEMPO_URL=

# ---------- Self-monitoring (read at startup only) ----------
# /metrics for Prometheus to scrape. On lab1 Prometheus can't receive pushes
# (remote write / OTLP receiver are off); once the backend runs as a pod, a
# ServiceMonitor points Prometheus at it. In dev, just open /metrics directly.
METRICS_ENABLED=true
# Logs only ever go to stdout; on the cluster Alloy ships pod stdout to Loki.
# text = readable console lines (dev), json = one JSON object per line (pods).
LOG_FORMAT=text

# ---------- Langfuse ----------
# READ ONLY AT STARTUP, not editable on web: the SDK keeps a singleton keyed by
# public key, so changing it at runtime is silently ignored. Edit here, then restart.
# Requires Langfuse version 3 or later — version 2 lacks the OTLP endpoint SDK 4.x uses.
# Nothing is sent unless LANGFUSE_ENABLED=true — having the keys is not enough.
# The URL can be given as LANGFUSE_HOST or LANGFUSE_BASE_URL (the SDK's newer name).
# On the lab1 cluster Langfuse is at http://lab1:30400.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
