# File này là cấu hình CỨNG — đọc một lần lúc khởi động.
# Những mục có ghi [đổi được trên web] thì giá trị ở đây chỉ là mặc định ban đầu;
# người dùng đổi trên giao diện sẽ đè lên và được lưu lại.
# Xem RUNTIME_EDITABLE trong app/core/config.py để biết trường nào đổi được.

# ---------- App ----------
APP_NAME="K8s Hub"
APP_ENV=local
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/k8shub

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Auth ----------
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---------- LLM ----------  [đổi được trên web]
# Chọn nhà cung cấp: groq | google | anthropic
LLM_PROVIDER=groq

# Để TRỐNG thì lấy model mặc định của nhà cung cấp (xem app/core/config.py).
LLM_MODEL=
LLM_FAST_MODEL=

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Ghi đè TỪNG PHẦN đặc tả nhà cung cấp, dạng JSON. Chỉ ghi trường cần đổi.
# Cũng dùng để THÊM nhà cung cấp mới mà không sửa config.py.
#   LLM_PROVIDERS={"groq": {"model": "llama-3.1-8b-instant"}}
# Để nguyên dạng chú thích nếu không cần ghi đè.
#LLM_PROVIDERS=

# Khoá API — chỉ cần điền cái của nhà cung cấp đang dùng.
GROQ_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Kubernetes ----------  [K8S_EXECUTION_MODE và ALLOWED_NAMESPACES đổi được trên web]
KUBECONFIG=
K8S_IN_CLUSTER=false
# read_only | require_approval | auto
K8S_EXECUTION_MODE=require_approval
K8S_ALLOWED_NAMESPACES=[]

# ---------- Observability data sources ----------  [đổi được trên web]
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100

# ---------- Langfuse ----------  [đổi được trên web]
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
